  <physbased_pbr_surface_to_standard_surface name="Pearl_standard_surface_SPB_translator" type="multioutput" nodedef="ND_physbased_pbr_surface_to_standard_surface">
    <input name="name" type="string" value="Pearl" />
    <input name="color" type="color3" value="0.8, 0.75, 0.7" colorspace="lin_rec709" />
    <input name="metalness" type="float" value="0" />
    <input name="roughness" type="float" value="0.35" />
    <input name="ior" type="float" value="1.68" />
