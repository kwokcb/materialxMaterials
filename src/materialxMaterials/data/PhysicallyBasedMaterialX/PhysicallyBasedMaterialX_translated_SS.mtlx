    <input name="color" type="color3" value="0.449, 0.319, 0.011" colorspace="lin_rec709" />
    <input name="metalness" type="float" value="0" />
    <input name="roughness" type="float" value="0.3" />
    <input name="ior" type="float" value="1.504" />
    <input name="subsurfaceRadius" type="vector3" value="0.2, 0.2, 0.2" />
    <input name="category" type="string" value="Organic" />
    <input name="description" type="string" value="Variations in its water content alter its refractive index. Typically, the refractive index for honey ranges from 1.504 at 13% water content to 1.474 at 25%. Fresh honey is liquid and clear but with time it crystallizes and becomes thicker and less clear. The crystallization depends on temperature and the ratio of glucose and fructose." />
    <input name="references" type="string" value="{'title': 'Honey', 'author': 'Wikipedia contributors', 'url': 'https://en.wikipedia.org/w/index.php?title=Honey&amp;oldid=1271742958', 'publisher': 'Wikipedia, The Free Encyclopedia', 'accessed': '2025-01-26'}, {'title': 'List of Viscosities', 'author': 'Wikipedia contributors', 'url': 'https://en.wikipedia.org/w/index.php?title=List_of_viscosities&amp;oldid=1256671906', 'publisher': 'Wikipedia, The Free Encyclopedia', 'accessed': '2025-01-26'}, {'title': 'The Color of Honey', 'url': 'https://carolinahoneybees.com/the-color-of-honey/', 'publisher': 'Carolina Honeybees', 'accessed': '2025-01-26'}, {'title': 'Chemical and Functional Properties of Food Saccharides', 'author': 'Tomasik, P. (Ed.)', 'url': 'https://www.taylorfrancis.com/books/mono/10.1201/9780203495728/chemical-functional-properties-food-saccharides-piotr-tomasik', 'publisher': 'CRC Press', 'pages': '74 ', 'year': '2003', 'doi': 'https://doi.org/10.1201/9780203495728'}, {'title': 'Viscosity of Flower Honey (Blended)', 'url': 'https://wiki.anton-paar.com/en/flower-honey-blended/', 'publisher': 'Anton Paar GmbH', 'accessed': '2025-01-26'}, {'title': 'Hybrido Viscosity Table', 'author': 'RealFlow 10 Documentation', 'publisher': 'Next Limit Technologies', 'url': 'https://nextlimitsupport.atlassian.net/wiki/spaces/rf2016docs/pages/5497120/Hybrido+Viscosity+Table', 'accessed': '2025-01-26'}, {'title': 'Viscosity - Absolute (Dynamic) vs. Kinematic ', 'url': 'https://www.engineeringtoolbox.com/dynamic-absolute-kinematic-viscosity-d_412.html', 'publisher': 'The Engineering ToolBox', 'accessed': '2025-01-26'}" />
    <input name="images" type="string" value="{'format': 'jpeg', '300': 'https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/300/honey-crystallized.jpeg', '600': 'https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/600/honey-crystallized.jpeg'}, {'format': 'avif', '300': 'https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/300/honey-crystallized.avif', '600': 'https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/600/honey-crystallized.avif'}" />
