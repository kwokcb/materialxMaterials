  <!-- Generated shader: Blood__Deoxygenated__GLTF_SHD_PBM -->
  <gltf_pbr name="Blood__Deoxygenated__GLTF_SHD_PBM" type="surfaceshader" uiname="Blood (Deoxygenated)" uifolder="Human" doc="The color of blood depends on its oxygen level. When hemoglobin has a full oxygen load, it has a bright red color, and when it's deoxygenated it's a darker red. For example, arterial and capillary blood is bright, and venous blood is dark. Upon exposure to air, deoxygenated blood quickly oxygenates and turns a brighter shade of red.. Reference: https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/300/blood-deoxygenated.avif">
