#usda 1.0
(
    customLayerData = {
        string author = "ambientCG (ambientCG.com)"
        string copyright = "CC0 1.0 Public Domain Dedication (https://creativecommons.org/publicdomain/zero/1.0/)"
        string generator = "ambientCG USD Script v4 (build_usdc_pbr_material.py)"
        string[] keywords = ["floor", "flooring", "herringbone", "parquet", "wood", "wooden"]
        string title = "Wood Floor 038"
        string type = "Material"
        string url = "https://ambientcg.com/a/WoodFloor038"
    }
    defaultPrim = "aCG_WoodFloor038_1K_PNG"
    metersPerUnit = 1
    upAxis = "Z"
)

def Material "aCG_WoodFloor038_1K_PNG"
{
    token outputs:surface.connect = </aCG_WoodFloor038_1K_PNG/PBRShader.outputs:surface>

    def Shader "TextureCoordinateReader"
    {
        uniform token info:id = "UsdPrimvarReader_float2"
        token inputs:varname = "st"
        float2 outputs:result
    }

    def Shader "PBRShader"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor.connect = </aCG_WoodFloor038_1K_PNG/diffuseColor.outputs:rgb>
        float inputs:displacement.connect = </aCG_WoodFloor038_1K_PNG/displacement.outputs:r>
        normal3f inputs:normal.connect = </aCG_WoodFloor038_1K_PNG/normal.outputs:rgb>
        float inputs:occlusion.connect = </aCG_WoodFloor038_1K_PNG/occlusion.outputs:r>
        float inputs:roughness.connect = </aCG_WoodFloor038_1K_PNG/roughness.outputs:r>
        int inputs:useSpecularWorkflow = 0
        token outputs:surface
    }

    def Shader "occlusion"
    {
        uniform token info:id = "UsdUVTexture"
        float4 inputs:fallback = (1, 1, 1, 1)
        asset inputs:file = @WoodFloor038_1K-PNG_AmbientOcclusion.png@
        token inputs:sourceColorSpace = "raw"
        token inputs:st.connect = </aCG_WoodFloor038_1K_PNG/TextureCoordinateReader.outputs:result>
        token inputs:wrapS = "repeat"
        token inputs:wrapT = "repeat"
        float3 outputs:r
    }

    def Shader "diffuseColor"
    {
        uniform token info:id = "UsdUVTexture"
        float4 inputs:fallback = (0.75, 0.75, 0.75, 1)
        asset inputs:file = @WoodFloor038_1K-PNG_Color.png@
        token inputs:sourceColorSpace = "sRGB"
        token inputs:st.connect = </aCG_WoodFloor038_1K_PNG/TextureCoordinateReader.outputs:result>
        token inputs:wrapS = "repeat"
        token inputs:wrapT = "repeat"
        float3 outputs:rgb
    }

    def Shader "displacement"
    {
        uniform token info:id = "UsdUVTexture"
        float4 inputs:fallback = (0, 0, 0, 1)
        asset inputs:file = @WoodFloor038_1K-PNG_Displacement.png@
        token inputs:sourceColorSpace = "raw"
        token inputs:st.connect = </aCG_WoodFloor038_1K_PNG/TextureCoordinateReader.outputs:result>
        token inputs:wrapS = "repeat"
        token inputs:wrapT = "repeat"
        float3 outputs:r
    }

    def Shader "normal"
    {
        uniform token info:id = "UsdUVTexture"
        float4 inputs:bias = (-1, -1, -1, 0)
        float4 inputs:fallback = (0, 0, 1, 1)
        asset inputs:file = @WoodFloor038_1K-PNG_NormalGL.png@
        float4 inputs:scale = (2, 2, 2, 1)
        token inputs:sourceColorSpace = "raw"
        token inputs:st.connect = </aCG_WoodFloor038_1K_PNG/TextureCoordinateReader.outputs:result>
        token inputs:wrapS = "repeat"
        token inputs:wrapT = "repeat"
        float3 outputs:rgb
    }

    def Shader "roughness"
    {
        uniform token info:id = "UsdUVTexture"
        float4 inputs:fallback = (0.5, 0.5, 0.5, 1)
        asset inputs:file = @WoodFloor038_1K-PNG_Roughness.png@
        token inputs:sourceColorSpace = "raw"
        token inputs:st.connect = </aCG_WoodFloor038_1K_PNG/TextureCoordinateReader.outputs:result>
        token inputs:wrapS = "repeat"
        token inputs:wrapT = "repeat"
        float3 outputs:r
    }
}

