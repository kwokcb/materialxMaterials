  <!--  Content processsed via REST API and mapped to MaterialX V1.39.5 -->
  <!--  Target Shading Model: standard_surface -->
  <!--  Utility Author: Bernard Kwok. kwokcb@gmail.com -->
  <!-- Generated shader: Iron_SS_SHD_PBM -->
  <standard_surface name="Iron_SS_SHD_PBM" type="surfaceshader" uiname="Iron" uifolder="Metal" doc="Reference: https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/300/iron.avif">
    <input name="base_color" type="color3" value="0.53, 0.513, 0.494" colorspace="lin_rec709" />
    <input name="metalness" type="float" value="1" />
    <input name="specular_color" type="color3" value="0.612, 0.541, 0.422" colorspace="lin_rec709" doc="Format: Gulbrandsen" />
    <input name="specular_roughness" type="float" value="0" />
  </standard_surface>
  <!-- Generated material: Iron_SS_MAT_PBM -->
  <surfacematerial name="Iron_SS_MAT_PBM" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Iron_SS_SHD_PBM" />
  </surfacematerial>
</materialx>
