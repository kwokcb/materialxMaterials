    <input name="metallic" type="float" value="1" />
    <input name="specular_color" type="color3" value="0.865, 0.906, 0.946" colorspace="lin_rec709" doc="Format: F82" />
    <input name="roughness" type="float" value="0" />
    <input name="iridescence_ior" type="float" value="2.488" />
    <input name="iridescence_thickness" type="float" value="20, 300" />
  </gltf_pbr>
  <!-- Generated material: Titanium__Anodized__GLTF_MAT_PBM -->
  <surfacematerial name="Titanium__Anodized__GLTF_MAT_PBM" type="material">
