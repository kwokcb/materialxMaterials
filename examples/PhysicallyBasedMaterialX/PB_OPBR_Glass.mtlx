    <input name="transmission_weight" type="float" value="1" />
    <input name="transmission_dispersion_abbe_number" type="float" value="64" />
    <input name="transmission_color" type="color3" value="1,1,1" />
  </open_pbr_surface>
  <!-- Generated material: Glass_OPBR_MAT_PBM -->
  <surfacematerial name="Glass_OPBR_MAT_PBM" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Glass_OPBR_SHD_PBM" />
