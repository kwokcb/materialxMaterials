  <physbased_pbr_surface_to_standard_surface name="Car_Paint_standard_surface_SPB_translator" type="multioutput" nodedef="ND_physbased_pbr_surface_to_standard_surface">
    <input name="name" type="string" value="Car Paint" />
    <input name="color" type="color3" value="0.1, 0.1, 0.1" />
    <input name="metalness" type="float" value="0" />
