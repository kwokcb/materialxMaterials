  <physbased_pbr_surface_to_standard_surface name="Blood_standard_surface_SPB_translator" type="multioutput" nodedef="ND_physbased_pbr_surface_to_standard_surface">
    <input name="name" type="string" value="Blood" />
    <input name="color" type="color3" value="0.64448, 0.003, 0.005" />
