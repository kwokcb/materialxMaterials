    <input name="specular_color" type="color3" value="0.731,0.775,0.715" />
    <input name="roughness" type="float" value="0" />
    <input name="ior" type="float" value="1.5" />
  </gltf_pbr>
  <!-- Generated material: Cobalt_GLTF_MAT_PBM -->
