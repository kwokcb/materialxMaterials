  <!-- Generated shader: Cobalt_GLTF_SHD_PBM -->
  <gltf_pbr name="Cobalt_GLTF_SHD_PBM" type="surfaceshader" uiname="Cobalt" uifolder="Metal" doc="Reference: https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/600/cobalt.jpeg">
    <input name="base_color" type="color3" value="0.699,0.704,0.671" />
