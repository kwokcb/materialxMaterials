<?xml version="1.0"?>
<materialx version="1.39">
  <!--Physically Based Materials from https://api.physicallybased.info -->
  <!--  Content Author: Anton Palmqvist, https://antonpalmqvist.com/ -->
  <!--  Content processsed via REST API and mapped to MaterialX V1.39.5 -->
  <!--  Utility Author: Bernard Kwok. kwokcb@gmail.com -->
  <surfacematerial name="Gold_MAT_PBM" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Gold_open_pbr_surface_SPB" />
  </surfacematerial>
  <open_pbr_surface name="Gold_open_pbr_surface_SPB" type="surfaceshader">
    <input name="base_color" type="color3" nodename="Gold_open_pbr_surface_SPB_translator" output="base_color_out" />
    <input name="base_metalness" type="float" nodename="Gold_open_pbr_surface_SPB_translator" output="base_metalness_out" />
    <input name="specular_color" type="color3" nodename="Gold_open_pbr_surface_SPB_translator" output="specular_color_out" />
    <input name="specular_roughness" type="float" nodename="Gold_open_pbr_surface_SPB_translator" output="specular_roughness_out" />
    <input name="specular_ior" type="float" nodename="Gold_open_pbr_surface_SPB_translator" output="specular_ior_out" />
    <input name="transmission_weight" type="float" nodename="Gold_open_pbr_surface_SPB_translator" output="transmission_weight_out" />
    <input name="transmission_dispersion_abbe_number" type="float" nodename="Gold_open_pbr_surface_SPB_translator" output="transmission_dispersion_abbe_number_out" />
    <input name="subsurface_radius" type="float" nodename="Gold_open_pbr_surface_SPB_translator" output="subsurface_radius_out" />
    <input name="thin_film_thickness" type="float" nodename="Gold_open_pbr_surface_SPB_translator" output="thin_film_thickness_out" />
    <input name="thin_film_ior" type="float" nodename="Gold_open_pbr_surface_SPB_translator" output="thin_film_ior_out" />
  </open_pbr_surface>
  <physbased_pbr_surface_to_open_pbr_surface name="Gold_open_pbr_surface_SPB_translator" type="multioutput" nodedef="ND_physbased_pbr_surface_to_open_pbr_surface">
    <input name="name" type="string" value="Gold" />
    <input name="color" type="color3" value="1.059, 0.773, 0.307" />
    <input name="metalness" type="float" value="1" />
    <input name="specularColor" type="color3" value="1.001, 0.985, 0.523" />
    <input name="roughness" type="float" value="0" />
    <input name="ior" type="float" value="1.5" />
    <input name="complexIor" type="string" value="0, 6.59401, 0.351563, 2.08143, 1.85894, 1.49631" />
    <input name="density" type="float" value="19320" />
    <input name="category" type="string" value="Metal" />
    <input name="description" type="string" value="" />
    <input name="sources" type="string" value="https://refractiveindex.info/?shelf=main&amp;book=Au&amp;page=Babar, https://arxiv.org/pdf/2512.23696#appendix.D, https://en.wikipedia.org/wiki/Density" />
    <input name="tags" type="string" value="" />
    <input name="reference" type="string" value="https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/600/gold.jpeg" />
    <output name="base_color_out" type="color3" />
    <output name="base_metalness_out" type="float" />
    <output name="specular_color_out" type="color3" />
    <output name="specular_roughness_out" type="float" />
    <output name="specular_ior_out" type="float" />
    <output name="transmission_weight_out" type="float" />
    <output name="transmission_dispersion_abbe_number_out" type="float" />
    <output name="subsurface_radius_out" type="float" />
    <output name="thin_film_thickness_out" type="float" />
    <output name="thin_film_ior_out" type="float" />
  </physbased_pbr_surface_to_open_pbr_surface>
</materialx>
