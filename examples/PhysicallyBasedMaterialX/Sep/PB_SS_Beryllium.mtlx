<?xml version="1.0"?>
<materialx version="1.39">
  <!--Physically Based Materials from https://api.physicallybased.info -->
  <!--  Content Author: Anton Palmqvist, https://antonpalmqvist.com/ -->
  <!--  Content processsed via REST API and mapped to MaterialX V1.39.5 -->
  <!--  Utility Author: Bernard Kwok. kwokcb@gmail.com -->
  <surfacematerial name="Beryllium_MAT_PBM" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Beryllium_standard_surface_SPB" />
  </surfacematerial>
  <standard_surface name="Beryllium_standard_surface_SPB" type="surfaceshader">
    <input name="base_color" type="color3" nodename="Beryllium_standard_surface_SPB_translator" output="base_color_out" />
    <input name="metalness" type="float" nodename="Beryllium_standard_surface_SPB_translator" output="metalness_out" />
    <input name="specular_color" type="color3" nodename="Beryllium_standard_surface_SPB_translator" output="specular_color_out" />
    <input name="specular_roughness" type="float" nodename="Beryllium_standard_surface_SPB_translator" output="specular_roughness_out" />
    <input name="specular_IOR" type="float" nodename="Beryllium_standard_surface_SPB_translator" output="specular_IOR_out" />
    <input name="transmission" type="float" nodename="Beryllium_standard_surface_SPB_translator" output="transmission_out" />
    <input name="transmission_dispersion" type="float" nodename="Beryllium_standard_surface_SPB_translator" output="transmission_dispersion_out" />
    <input name="subsurface_radius" type="color3" nodename="Beryllium_standard_surface_SPB_translator" output="subsurface_radius_out" />
    <input name="thin_film_thickness" type="float" nodename="Beryllium_standard_surface_SPB_translator" output="thin_film_thickness_out" />
    <input name="thin_film_IOR" type="float" nodename="Beryllium_standard_surface_SPB_translator" output="thin_film_IOR_out" />
  </standard_surface>
  <physbased_pbr_surface_to_standard_surface name="Beryllium_standard_surface_SPB_translator" type="multioutput" nodedef="ND_physbased_pbr_surface_to_standard_surface">
    <input name="name" type="string" value="Beryllium" />
    <input name="color" type="color3" value="0.539, 0.533, 0.534" />
    <input name="metalness" type="float" value="1" />
    <input name="specularColor" type="color3" value="0.549, 0.503, 0.364" />
    <input name="roughness" type="float" value="0" />
    <input name="ior" type="float" value="1.5" />
    <input name="complexIor" type="string" value="3.21038, 3.29815, 3.32907, 3.11669, 3.77105, 2.66995" />
    <input name="density" type="float" value="1850" />
    <input name="category" type="string" value="Metal" />
    <input name="description" type="string" value="" />
    <input name="sources" type="string" value="https://refractiveindex.info/?shelf=main&amp;book=Be&amp;page=Rakic-BB, https://arxiv.org/pdf/2512.23696#appendix.D, https://en.wikipedia.org/w/index.php?title=Beryllium&amp;oldid=1295895956, https://en.wikipedia.org/wiki/Density" />
    <input name="tags" type="string" value="" />
    <input name="reference" type="string" value="https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/600/beryllium.jpeg" />
    <output name="base_color_out" type="color3" />
    <output name="metalness_out" type="float" />
    <output name="specular_color_out" type="color3" />
    <output name="specular_roughness_out" type="float" />
    <output name="specular_IOR_out" type="float" />
    <output name="transmission_out" type="float" />
    <output name="transmission_dispersion_out" type="float" />
    <output name="subsurface_radius_out" type="color3" />
    <output name="thin_film_thickness_out" type="float" />
    <output name="thin_film_IOR_out" type="float" />
  </physbased_pbr_surface_to_standard_surface>
</materialx>
