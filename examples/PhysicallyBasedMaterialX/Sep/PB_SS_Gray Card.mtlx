<?xml version="1.0"?>
<materialx version="1.39">
  <!--Physically Based Materials from https://api.physicallybased.info -->
  <!--  Content Author: Anton Palmqvist, https://antonpalmqvist.com/ -->
  <!--  Content processsed via REST API and mapped to MaterialX V1.39.5 -->
  <!--  Utility Author: Bernard Kwok. kwokcb@gmail.com -->
  <surfacematerial name="Gray_Card_MAT_PBM" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Gray_Card_standard_surface_SPB" />
  </surfacematerial>
  <standard_surface name="Gray_Card_standard_surface_SPB" type="surfaceshader">
    <input name="base_color" type="color3" nodename="Gray_Card_standard_surface_SPB_translator" output="base_color_out" />
    <input name="metalness" type="float" nodename="Gray_Card_standard_surface_SPB_translator" output="metalness_out" />
    <input name="specular_color" type="color3" nodename="Gray_Card_standard_surface_SPB_translator" output="specular_color_out" />
    <input name="specular_roughness" type="float" nodename="Gray_Card_standard_surface_SPB_translator" output="specular_roughness_out" />
    <input name="specular_IOR" type="float" nodename="Gray_Card_standard_surface_SPB_translator" output="specular_IOR_out" />
    <input name="transmission" type="float" nodename="Gray_Card_standard_surface_SPB_translator" output="transmission_out" />
    <input name="transmission_dispersion" type="float" nodename="Gray_Card_standard_surface_SPB_translator" output="transmission_dispersion_out" />
    <input name="subsurface_radius" type="color3" nodename="Gray_Card_standard_surface_SPB_translator" output="subsurface_radius_out" />
    <input name="thin_film_thickness" type="float" nodename="Gray_Card_standard_surface_SPB_translator" output="thin_film_thickness_out" />
    <input name="thin_film_IOR" type="float" nodename="Gray_Card_standard_surface_SPB_translator" output="thin_film_IOR_out" />
  </standard_surface>
  <physbased_pbr_surface_to_standard_surface name="Gray_Card_standard_surface_SPB_translator" type="multioutput" nodedef="ND_physbased_pbr_surface_to_standard_surface">
    <input name="name" type="string" value="Gray Card" />
    <input name="color" type="color3" value="0.18, 0.18, 0.18" />
    <input name="metalness" type="float" value="0" />
    <input name="roughness" type="float" value="0.9" />
    <input name="ior" type="float" value="1.5" />
    <input name="density" type="float" value="0" />
    <input name="category" type="string" value="Manmade" />
    <input name="description" type="string" value="In photography and computer graphics, middle gray is a tone that is perceptually about halfway between black and white on a lightness scale. Light meters and cameras are often calibrated using an 18% gray card or a color reference card such as a ColorChecker. It is typically defined as 18% reflectance in visible light." />
    <input name="sources" type="string" value="https://en.wikipedia.org/w/index.php?title=Gray_card&amp;oldid=1244084939, https://www.xrite.com/service-support/new_color_specifications_for_colorchecker_sg_and_classic_charts, https://babelcolor.com/colorchecker.htm, https://github.com/colour-science/colour-nuke/tree/master/colour_nuke/resources/images/ColorChecker2014" />
    <input name="tags" type="string" value="grey, middle gray" />
    <input name="reference" type="string" value="https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/600/gray-card.jpeg" />
    <output name="base_color_out" type="color3" />
    <output name="metalness_out" type="float" />
    <output name="specular_color_out" type="color3" />
    <output name="specular_roughness_out" type="float" />
    <output name="specular_IOR_out" type="float" />
    <output name="transmission_out" type="float" />
    <output name="transmission_dispersion_out" type="float" />
    <output name="subsurface_radius_out" type="color3" />
    <output name="thin_film_thickness_out" type="float" />
    <output name="thin_film_IOR_out" type="float" />
  </physbased_pbr_surface_to_standard_surface>
</materialx>
