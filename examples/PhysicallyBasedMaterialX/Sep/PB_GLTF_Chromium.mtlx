<?xml version="1.0"?>
<materialx version="1.39">
  <!--Physically Based Materials from https://api.physicallybased.info -->
  <!--  Content Author: Anton Palmqvist, https://antonpalmqvist.com/ -->
  <!--  Content processsed via REST API and mapped to MaterialX V1.39.5 -->
  <!--  Utility Author: Bernard Kwok. kwokcb@gmail.com -->
  <surfacematerial name="Chromium_MAT_PBM" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Chromium_gltf_pbr_SPB" />
  </surfacematerial>
  <gltf_pbr name="Chromium_gltf_pbr_SPB" type="surfaceshader">
    <input name="base_color" type="color3" nodename="Chromium_gltf_pbr_SPB_translator" output="base_color_out" />
    <input name="metallic" type="float" nodename="Chromium_gltf_pbr_SPB_translator" output="metallic_out" />
    <input name="roughness" type="float" nodename="Chromium_gltf_pbr_SPB_translator" output="roughness_out" />
    <input name="transmission" type="float" nodename="Chromium_gltf_pbr_SPB_translator" output="transmission_out" />
    <input name="specular_color" type="color3" nodename="Chromium_gltf_pbr_SPB_translator" output="specular_color_out" />
    <input name="ior" type="float" nodename="Chromium_gltf_pbr_SPB_translator" output="ior_out" />
    <input name="iridescence_ior" type="float" nodename="Chromium_gltf_pbr_SPB_translator" output="iridescence_ior_out" />
    <input name="iridescence_thickness" type="float" nodename="Chromium_gltf_pbr_SPB_translator" output="iridescence_thickness_out" />
  </gltf_pbr>
  <physbased_pbr_surface_to_gltf_pbr name="Chromium_gltf_pbr_SPB_translator" type="multioutput" nodedef="ND_physbased_pbr_surface_to_gltf_pbr">
    <input name="name" type="string" value="Chromium" />
    <input name="color" type="color3" value="0.654, 0.685, 0.701" />
    <input name="metalness" type="float" value="1" />
    <input name="specularColor" type="color3" value="0.591, 0.675, 0.703" />
    <input name="roughness" type="float" value="0" />
    <input name="ior" type="float" value="1.5" />
    <input name="complexIor" type="string" value="4.19382, 4.85545, 3.53806, 4.89986, 2.91521, 4.25568" />
    <input name="density" type="float" value="7200" />
    <input name="category" type="string" value="Metal" />
    <input name="description" type="string" value="" />
    <input name="sources" type="string" value="https://refractiveindex.info/?shelf=main&amp;book=Cr&amp;page=Sytchkova, https://arxiv.org/pdf/2512.23696#appendix.D, https://en.wikipedia.org/wiki/Density" />
    <input name="tags" type="string" value="chrome" />
    <input name="reference" type="string" value="https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/600/chromium.jpeg" />
    <output name="base_color_out" type="color3" />
    <output name="metallic_out" type="float" />
    <output name="roughness_out" type="float" />
    <output name="transmission_out" type="float" />
    <output name="specular_color_out" type="color3" />
    <output name="ior_out" type="float" />
    <output name="iridescence_ior_out" type="float" />
    <output name="iridescence_thickness_out" type="float" />
  </physbased_pbr_surface_to_gltf_pbr>
</materialx>
