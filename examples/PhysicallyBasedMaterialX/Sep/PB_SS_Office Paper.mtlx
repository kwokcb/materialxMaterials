<?xml version="1.0"?>
<materialx version="1.39">
  <!--Physically Based Materials from https://api.physicallybased.info -->
  <!--  Content Author: Anton Palmqvist, https://antonpalmqvist.com/ -->
  <!--  Content processsed via REST API and mapped to MaterialX V1.39.5 -->
  <!--  Utility Author: Bernard Kwok. kwokcb@gmail.com -->
  <surfacematerial name="Office_Paper_MAT_PBM" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Office_Paper_standard_surface_SPB" />
  </surfacematerial>
  <standard_surface name="Office_Paper_standard_surface_SPB" type="surfaceshader">
    <input name="base_color" type="color3" nodename="Office_Paper_standard_surface_SPB_translator" output="base_color_out" />
    <input name="metalness" type="float" nodename="Office_Paper_standard_surface_SPB_translator" output="metalness_out" />
    <input name="specular_color" type="color3" nodename="Office_Paper_standard_surface_SPB_translator" output="specular_color_out" />
    <input name="specular_roughness" type="float" nodename="Office_Paper_standard_surface_SPB_translator" output="specular_roughness_out" />
    <input name="specular_IOR" type="float" nodename="Office_Paper_standard_surface_SPB_translator" output="specular_IOR_out" />
    <input name="transmission" type="float" nodename="Office_Paper_standard_surface_SPB_translator" output="transmission_out" />
    <input name="transmission_dispersion" type="float" nodename="Office_Paper_standard_surface_SPB_translator" output="transmission_dispersion_out" />
    <input name="subsurface_radius" type="color3" nodename="Office_Paper_standard_surface_SPB_translator" output="subsurface_radius_out" />
    <input name="thin_film_thickness" type="float" nodename="Office_Paper_standard_surface_SPB_translator" output="thin_film_thickness_out" />
    <input name="thin_film_IOR" type="float" nodename="Office_Paper_standard_surface_SPB_translator" output="thin_film_IOR_out" />
  </standard_surface>
  <physbased_pbr_surface_to_standard_surface name="Office_Paper_standard_surface_SPB_translator" type="multioutput" nodedef="ND_physbased_pbr_surface_to_standard_surface">
    <input name="name" type="string" value="Office Paper" />
    <input name="color" type="color3" value="0.794, 0.834, 0.884" />
    <input name="metalness" type="float" value="0" />
    <input name="roughness" type="float" value="0.8" />
    <input name="ior" type="float" value="1.5" />
    <input name="density" type="float" value="800" />
    <input name="category" type="string" value="Manmade" />
    <input name="description" type="string" value="Office paper contains optical brightening additives that absorb light in the ultraviolet and violet region (usually 340-370 nm), and re-emit light in the blue region (typically 420-470 nm) by fluorescence." />
    <input name="sources" type="string" value="https://github.com/AntonPalmqvist/physically-based-api/tree/main/data/materials/office-paper, https://en.wikipedia.org/wiki/Paper#Types,_thickness_and_weight, https://en.wikipedia.org/wiki/Optical_brightener" />
    <input name="tags" type="string" value="" />
    <input name="reference" type="string" value="https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/600/office-paper.jpeg" />
    <output name="base_color_out" type="color3" />
    <output name="metalness_out" type="float" />
    <output name="specular_color_out" type="color3" />
    <output name="specular_roughness_out" type="float" />
    <output name="specular_IOR_out" type="float" />
    <output name="transmission_out" type="float" />
    <output name="transmission_dispersion_out" type="float" />
    <output name="subsurface_radius_out" type="color3" />
    <output name="thin_film_thickness_out" type="float" />
    <output name="thin_film_IOR_out" type="float" />
  </physbased_pbr_surface_to_standard_surface>
</materialx>
