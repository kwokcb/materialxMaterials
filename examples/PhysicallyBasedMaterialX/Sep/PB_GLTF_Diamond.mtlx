<?xml version="1.0"?>
<materialx version="1.39">
  <!--Physically Based Materials from https://api.physicallybased.info -->
  <!--  Content Author: Anton Palmqvist, https://antonpalmqvist.com/ -->
  <!--  Content processsed via REST API and mapped to MaterialX V1.39.5 -->
  <!--  Utility Author: Bernard Kwok. kwokcb@gmail.com -->
  <surfacematerial name="Diamond_MAT_PBM" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Diamond_gltf_pbr_SPB" />
  </surfacematerial>
  <gltf_pbr name="Diamond_gltf_pbr_SPB" type="surfaceshader">
    <input name="base_color" type="color3" nodename="Diamond_gltf_pbr_SPB_translator" output="base_color_out" />
    <input name="metallic" type="float" nodename="Diamond_gltf_pbr_SPB_translator" output="metallic_out" />
    <input name="roughness" type="float" nodename="Diamond_gltf_pbr_SPB_translator" output="roughness_out" />
    <input name="transmission" type="float" nodename="Diamond_gltf_pbr_SPB_translator" output="transmission_out" />
    <input name="specular_color" type="color3" nodename="Diamond_gltf_pbr_SPB_translator" output="specular_color_out" />
    <input name="ior" type="float" nodename="Diamond_gltf_pbr_SPB_translator" output="ior_out" />
    <input name="iridescence_ior" type="float" nodename="Diamond_gltf_pbr_SPB_translator" output="iridescence_ior_out" />
    <input name="iridescence_thickness" type="float" nodename="Diamond_gltf_pbr_SPB_translator" output="iridescence_thickness_out" />
  </gltf_pbr>
  <physbased_pbr_surface_to_gltf_pbr name="Diamond_gltf_pbr_SPB_translator" type="multioutput" nodedef="ND_physbased_pbr_surface_to_gltf_pbr">
    <input name="name" type="string" value="Diamond" />
    <input name="color" type="color3" value="1, 1, 1" />
    <input name="metalness" type="float" value="0" />
    <input name="roughness" type="float" value="0" />
    <input name="ior" type="float" value="2.4168" />
    <input name="transmission" type="float" value="1" />
    <input name="transmissionDispersion" type="float" value="55.3" />
    <input name="density" type="float" value="3500" />
    <input name="category" type="string" value="Crystal" />
    <input name="description" type="string" value="" />
    <input name="sources" type="string" value="https://refractiveindex.info/?shelf=3d&amp;book=crystals&amp;page=diamond, https://refractiveindex.info/?shelf=main&amp;book=C&amp;page=Peter, https://www.gemsociety.org/article/table-refractive-index-double-refraction-gems/, https://en.wikipedia.org/wiki/Density" />
    <input name="tags" type="string" value="gem, gemstone" />
    <input name="reference" type="string" value="https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/600/diamond.jpeg" />
    <output name="base_color_out" type="color3" />
    <output name="metallic_out" type="float" />
    <output name="roughness_out" type="float" />
    <output name="transmission_out" type="float" />
    <output name="specular_color_out" type="color3" />
    <output name="ior_out" type="float" />
    <output name="iridescence_ior_out" type="float" />
    <output name="iridescence_thickness_out" type="float" />
  </physbased_pbr_surface_to_gltf_pbr>
</materialx>
