<?xml version="1.0"?>
<materialx version="1.39">
  <!--Physically Based Materials from https://api.physicallybased.info -->
  <!--  Content Author: Anton Palmqvist, https://antonpalmqvist.com/ -->
  <!--  Content processsed via REST API and mapped to MaterialX V1.39.5 -->
  <!--  Utility Author: Bernard Kwok. kwokcb@gmail.com -->
  <surfacematerial name="Lithium_MAT_PBM" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Lithium_gltf_pbr_SPB" />
  </surfacematerial>
  <gltf_pbr name="Lithium_gltf_pbr_SPB" type="surfaceshader">
    <input name="base_color" type="color3" nodename="Lithium_gltf_pbr_SPB_translator" output="base_color_out" />
    <input name="metallic" type="float" nodename="Lithium_gltf_pbr_SPB_translator" output="metallic_out" />
    <input name="roughness" type="float" nodename="Lithium_gltf_pbr_SPB_translator" output="roughness_out" />
    <input name="transmission" type="float" nodename="Lithium_gltf_pbr_SPB_translator" output="transmission_out" />
    <input name="specular_color" type="color3" nodename="Lithium_gltf_pbr_SPB_translator" output="specular_color_out" />
    <input name="ior" type="float" nodename="Lithium_gltf_pbr_SPB_translator" output="ior_out" />
    <input name="iridescence_ior" type="float" nodename="Lithium_gltf_pbr_SPB_translator" output="iridescence_ior_out" />
    <input name="iridescence_thickness" type="float" nodename="Lithium_gltf_pbr_SPB_translator" output="iridescence_thickness_out" />
  </gltf_pbr>
  <physbased_pbr_surface_to_gltf_pbr name="Lithium_gltf_pbr_SPB_translator" type="multioutput" nodedef="ND_physbased_pbr_surface_to_gltf_pbr">
    <input name="name" type="string" value="Lithium" />
    <input name="color" type="color3" value="0.916, 0.89, 0.807" />
    <input name="metalness" type="float" value="1" />
    <input name="specularColor" type="color3" value="0.998, 0.995, 0.975" />
    <input name="roughness" type="float" value="0" />
    <input name="ior" type="float" value="1.5" />
    <input name="complexIor" type="string" value="0.141612, 2.7434, 0.215656, 2.48258, 0.481854, 2.35726" />
    <input name="density" type="float" value="535" />
    <input name="category" type="string" value="Metal" />
    <input name="description" type="string" value="" />
    <input name="sources" type="string" value="https://refractiveindex.info/?shelf=main&amp;book=Li&amp;page=Rasigni, https://arxiv.org/pdf/2512.23696#appendix.D, https://en.wikipedia.org/w/index.php?title=Lithium&amp;oldid=1297355131" />
    <input name="tags" type="string" value="" />
    <input name="reference" type="string" value="https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/600/lithium.jpeg" />
    <output name="base_color_out" type="color3" />
    <output name="metallic_out" type="float" />
    <output name="roughness_out" type="float" />
    <output name="transmission_out" type="float" />
    <output name="specular_color_out" type="color3" />
    <output name="ior_out" type="float" />
    <output name="iridescence_ior_out" type="float" />
    <output name="iridescence_thickness_out" type="float" />
  </physbased_pbr_surface_to_gltf_pbr>
</materialx>
