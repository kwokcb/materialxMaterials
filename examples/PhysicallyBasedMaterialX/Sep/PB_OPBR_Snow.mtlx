<?xml version="1.0"?>
<materialx version="1.39">
  <!--Physically Based Materials from https://api.physicallybased.info -->
  <!--  Content Author: Anton Palmqvist, https://antonpalmqvist.com/ -->
  <!--  Content processsed via REST API and mapped to MaterialX V1.39.5 -->
  <!--  Utility Author: Bernard Kwok. kwokcb@gmail.com -->
  <surfacematerial name="Snow_MAT_PBM" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Snow_open_pbr_surface_SPB" />
  </surfacematerial>
  <open_pbr_surface name="Snow_open_pbr_surface_SPB" type="surfaceshader">
    <input name="base_color" type="color3" nodename="Snow_open_pbr_surface_SPB_translator" output="base_color_out" />
    <input name="base_metalness" type="float" nodename="Snow_open_pbr_surface_SPB_translator" output="base_metalness_out" />
    <input name="specular_color" type="color3" nodename="Snow_open_pbr_surface_SPB_translator" output="specular_color_out" />
    <input name="specular_roughness" type="float" nodename="Snow_open_pbr_surface_SPB_translator" output="specular_roughness_out" />
    <input name="specular_ior" type="float" nodename="Snow_open_pbr_surface_SPB_translator" output="specular_ior_out" />
    <input name="transmission_weight" type="float" nodename="Snow_open_pbr_surface_SPB_translator" output="transmission_weight_out" />
    <input name="transmission_dispersion_abbe_number" type="float" nodename="Snow_open_pbr_surface_SPB_translator" output="transmission_dispersion_abbe_number_out" />
    <input name="subsurface_radius" type="float" nodename="Snow_open_pbr_surface_SPB_translator" output="subsurface_radius_out" />
    <input name="thin_film_thickness" type="float" nodename="Snow_open_pbr_surface_SPB_translator" output="thin_film_thickness_out" />
    <input name="thin_film_ior" type="float" nodename="Snow_open_pbr_surface_SPB_translator" output="thin_film_ior_out" />
  </open_pbr_surface>
  <physbased_pbr_surface_to_open_pbr_surface name="Snow_open_pbr_surface_SPB_translator" type="multioutput" nodedef="ND_physbased_pbr_surface_to_open_pbr_surface">
    <input name="name" type="string" value="Snow" />
    <input name="color" type="color3" value="0.85, 0.85, 0.85" />
    <input name="metalness" type="float" value="0" />
    <input name="roughness" type="float" value="0.5" />
    <input name="ior" type="float" value="1.3098" />
    <input name="subsurfaceRadius" type="vector3" value="0.2, 0.2, 1" />
    <input name="density" type="float" value="100" />
    <input name="densityRange" type="vector2" value="90, 450" />
    <input name="acousticAbsorption" type="string" value="0.45, 0.75, 0.9, 0.95, 0.95, 0.95" />
    <input name="category" type="string" value="Crystal" />
    <input name="description" type="string" value="" />
    <input name="sources" type="string" value="https://seblagarde.wordpress.com/2011/08/17/feeding-a-physical-based-lighting-mode/, https://refractiveindex.info/?shelf=3d&amp;book=crystals&amp;page=ice, https://web.archive.org/web/20230605174450/http://mapleintegration.com/sound_ab.php" />
    <input name="tags" type="string" value="ice" />
    <input name="reference" type="string" value="https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/600/snow.jpeg" />
    <output name="base_color_out" type="color3" />
    <output name="base_metalness_out" type="float" />
    <output name="specular_color_out" type="color3" />
    <output name="specular_roughness_out" type="float" />
    <output name="specular_ior_out" type="float" />
    <output name="transmission_weight_out" type="float" />
    <output name="transmission_dispersion_abbe_number_out" type="float" />
    <output name="subsurface_radius_out" type="float" />
    <output name="thin_film_thickness_out" type="float" />
    <output name="thin_film_ior_out" type="float" />
  </physbased_pbr_surface_to_open_pbr_surface>
</materialx>
