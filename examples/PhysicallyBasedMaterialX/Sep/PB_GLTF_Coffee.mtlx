<?xml version="1.0"?>
<materialx version="1.39">
  <!--Physically Based Materials from https://api.physicallybased.info -->
  <!--  Content Author: Anton Palmqvist, https://antonpalmqvist.com/ -->
  <!--  Content processsed via REST API and mapped to MaterialX V1.39.5 -->
  <!--  Utility Author: Bernard Kwok. kwokcb@gmail.com -->
  <surfacematerial name="Coffee_MAT_PBM" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Coffee_gltf_pbr_SPB" />
  </surfacematerial>
  <gltf_pbr name="Coffee_gltf_pbr_SPB" type="surfaceshader">
    <input name="base_color" type="color3" nodename="Coffee_gltf_pbr_SPB_translator" output="base_color_out" />
    <input name="metallic" type="float" nodename="Coffee_gltf_pbr_SPB_translator" output="metallic_out" />
    <input name="roughness" type="float" nodename="Coffee_gltf_pbr_SPB_translator" output="roughness_out" />
    <input name="transmission" type="float" nodename="Coffee_gltf_pbr_SPB_translator" output="transmission_out" />
    <input name="specular_color" type="color3" nodename="Coffee_gltf_pbr_SPB_translator" output="specular_color_out" />
    <input name="ior" type="float" nodename="Coffee_gltf_pbr_SPB_translator" output="ior_out" />
    <input name="iridescence_ior" type="float" nodename="Coffee_gltf_pbr_SPB_translator" output="iridescence_ior_out" />
    <input name="iridescence_thickness" type="float" nodename="Coffee_gltf_pbr_SPB_translator" output="iridescence_thickness_out" />
  </gltf_pbr>
  <physbased_pbr_surface_to_gltf_pbr name="Coffee_gltf_pbr_SPB_translator" type="multioutput" nodedef="ND_physbased_pbr_surface_to_gltf_pbr">
    <input name="name" type="string" value="Coffee" />
    <input name="color" type="color3" value="0.447, 0.133, 0.034" />
    <input name="metalness" type="float" value="0" />
    <input name="roughness" type="float" value="0" />
    <input name="ior" type="float" value="1.34" />
    <input name="transmission" type="float" value="1" />
    <input name="transmissionDepth" type="float" value="0.1" />
    <input name="transmissionDispersion" type="float" value="55.78" />
    <input name="density" type="float" value="1020" />
    <input name="viscosity" type="float" value="1.7" />
    <input name="category" type="string" value="Liquid" />
    <input name="description" type="string" value="" />
    <input name="sources" type="string" value="https://github.com/AntonPalmqvist/physically-based-api/tree/main/data/materials/coffee/, https://books.google.com/books?id=cptQBAAAQBAJ&amp;lpg=PP1" />
    <input name="tags" type="string" value="sss" />
    <input name="reference" type="string" value="https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/600/coffee.jpeg" />
    <output name="base_color_out" type="color3" />
    <output name="metallic_out" type="float" />
    <output name="roughness_out" type="float" />
    <output name="transmission_out" type="float" />
    <output name="specular_color_out" type="color3" />
    <output name="ior_out" type="float" />
    <output name="iridescence_ior_out" type="float" />
    <output name="iridescence_thickness_out" type="float" />
  </physbased_pbr_surface_to_gltf_pbr>
</materialx>
