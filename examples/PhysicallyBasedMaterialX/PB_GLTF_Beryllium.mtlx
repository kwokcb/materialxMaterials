  <!-- Generated shader: Beryllium_GLTF_SHD_PBM -->
  <gltf_pbr name="Beryllium_GLTF_SHD_PBM" type="surfaceshader" uiname="Beryllium" uifolder="Metal" doc="Reference: https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/600/beryllium.jpeg">
    <input name="base_color" type="color3" value="0.539,0.533,0.534" />
    <input name="metallic" type="float" value="1" />
    <input name="specular_color" type="color3" value="0.549,0.503,0.364" />
    <input name="roughness" type="float" value="0" />
    <input name="ior" type="float" value="1.5" />
  </gltf_pbr>
  <!-- Generated material: Beryllium_GLTF_MAT_PBM -->
  <surfacematerial name="Beryllium_GLTF_MAT_PBM" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Beryllium_GLTF_SHD_PBM" />
  </surfacematerial>
