  <!-- Generated shader: Gold_SS_SHD_PBM -->
  <standard_surface name="Gold_SS_SHD_PBM" type="surfaceshader" uiname="Gold" uifolder="Metal" doc="Reference: https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/300/gold.avif">
    <input name="base_color" type="color3" value="1.059, 0.773, 0.307" colorspace="lin_rec709" />
    <input name="metalness" type="float" value="1" />
    <input name="specular_color" type="color3" value="1.001, 0.985, 0.523" colorspace="lin_rec709" doc="Format: Gulbrandsen" />
    <input name="specular_roughness" type="float" value="0" />
  </standard_surface>
  <!-- Generated material: Gold_SS_MAT_PBM -->
  <surfacematerial name="Gold_SS_MAT_PBM" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Gold_SS_SHD_PBM" />
  </surfacematerial>
