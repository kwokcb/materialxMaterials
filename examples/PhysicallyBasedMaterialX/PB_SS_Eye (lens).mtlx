  <standard_surface name="Eye__Lens__SS_SHD_PBM" type="surfaceshader" uiname="Eye (Lens)" uifolder="Human" doc="The refractive index of human lens varies from approximately 1.406 in the central layers down to 1.386 in less dense layers of the lens. This index gradient enhances the optical power of the lens.. Reference: https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/300/eye-lens.avif">
    <input name="base_color" type="color3" value="1, 1, 1" colorspace="lin_rec709" />
    <input name="metalness" type="float" value="0" />
    <input name="specular_roughness" type="float" value="0" />
    <input name="specular_IOR" type="float" value="1.386" />
    <input name="transmission" type="float" value="1" />
    <input name="transmission_color" type="color3" value="1,1,1" colorspace="lin_rec709" />
  </standard_surface>
  <!-- Generated material: Eye__Lens__SS_MAT_PBM -->
  <surfacematerial name="Eye__Lens__SS_MAT_PBM" type="material">
