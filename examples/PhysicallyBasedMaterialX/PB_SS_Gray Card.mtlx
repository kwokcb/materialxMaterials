  <!-- Generated shader: Gray_Card_SS_SHD_PBM -->
  <standard_surface name="Gray_Card_SS_SHD_PBM" type="surfaceshader" uiname="Gray Card" uifolder="Manmade" doc="In photography and computer graphics, middle gray is a tone that is perceptually about halfway between black and white on a lightness scale. Light meters and cameras are often calibrated using an 18% gray card or a color reference card such as a ColorChecker. It is typically defined as 18% reflectance in visible light.. Reference: https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/300/gray-card.avif">
    <input name="base_color" type="color3" value="0.18, 0.18, 0.18" colorspace="lin_rec709" />
    <input name="metalness" type="float" value="0" />
    <input name="specular_roughness" type="float" value="0.9" />
    <input name="specular_IOR" type="float" value="1.5" />
  </standard_surface>
  <!-- Generated material: Gray_Card_SS_MAT_PBM -->
  <surfacematerial name="Gray_Card_SS_MAT_PBM" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Gray_Card_SS_SHD_PBM" />
  </surfacematerial>
