  <!-- Generated shader: Snow_SS_SHD_PBM -->
  <standard_surface name="Snow_SS_SHD_PBM" type="surfaceshader" uiname="Snow" uifolder="Crystal" doc="Reference: https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/600/snow.jpeg">
    <input name="base_color" type="color3" value="0.85,0.85,0.85" />
    <input name="metalness" type="float" value="0" />
    <input name="specular_roughness" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.3098" />
    <input name="subsurface_radius" type="color3" value="0.2,0.2,1" />
  </standard_surface>
  <!-- Generated material: Snow_SS_MAT_PBM -->
  <surfacematerial name="Snow_SS_MAT_PBM" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Snow_SS_SHD_PBM" />
  </surfacematerial>
