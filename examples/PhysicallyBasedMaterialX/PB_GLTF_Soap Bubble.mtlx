  <!-- Generated shader: Soap_Bubble_GLTF_SHD_PBM -->
  <gltf_pbr name="Soap_Bubble_GLTF_SHD_PBM" type="surfaceshader" uiname="Soap Bubble" uifolder="Organic" doc="The colors of a soap bubble are the result of an interaction between the light reflected from the front and back surfaces of the soap film, a phenomenon known as thin-film interference. The thickness of a soap bubble can range between 10 nm and 1000 nm. It's thinner at the top due to gravity.. Reference: https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/300/soap-bubble.avif">
    <input name="base_color" type="color3" value="1, 1, 1" colorspace="lin_rec709" />
    <input name="metallic" type="float" value="0" />
    <input name="roughness" type="float" value="0" />
    <input name="ior" type="float" value="1" />
    <input name="transmission" type="float" value="1" />
    <input name="iridescence_thickness" type="float" value="10, 1000, 500" />
    <input name="iridescence_ior" type="float" value="1.4" />
    <input name="attenuation_color" type="color3" value="1,1,1" colorspace="lin_rec709" />
  </gltf_pbr>
  <!-- Generated material: Soap_Bubble_GLTF_MAT_PBM -->
  <surfacematerial name="Soap_Bubble_GLTF_MAT_PBM" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Soap_Bubble_GLTF_SHD_PBM" />
  </surfacematerial>
</materialx>
