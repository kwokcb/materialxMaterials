  <!--  Target Shading Model: gltf_pbr -->
  <!--  Utility Author: Bernard Kwok. kwokcb@gmail.com -->
  <!-- Generated shader: Iridium_GLTF_SHD_PBM -->
  <gltf_pbr name="Iridium_GLTF_SHD_PBM" type="surfaceshader" uiname="Iridium" uifolder="Metal" doc="Reference: https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/300/iridium.avif">
    <input name="base_color" type="color3" value="0.745, 0.734, 0.704" colorspace="lin_rec709" />
    <input name="metallic" type="float" value="1" />
    <input name="specular_color" type="color3" value="0.759, 0.781, 0.81" colorspace="lin_rec709" doc="Format: F82" />
    <input name="roughness" type="float" value="0" />
  </gltf_pbr>
  <!-- Generated material: Iridium_GLTF_MAT_PBM -->
  <surfacematerial name="Iridium_GLTF_MAT_PBM" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Iridium_GLTF_SHD_PBM" />
  </surfacematerial>
