  <!-- Generated shader: Chromium_GLTF_SHD_PBM -->
  <gltf_pbr name="Chromium_GLTF_SHD_PBM" type="surfaceshader" uiname="Chromium" uifolder="Metal" doc="Reference: https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/600/chromium.jpeg">
    <input name="base_color" type="color3" value="0.654,0.685,0.701" />
    <input name="metallic" type="float" value="1" />
    <input name="specular_color" type="color3" value="0.591,0.675,0.703" />
    <input name="roughness" type="float" value="0" />
    <input name="ior" type="float" value="1.5" />
  </gltf_pbr>
  <!-- Generated material: Chromium_GLTF_MAT_PBM -->
  <surfacematerial name="Chromium_GLTF_MAT_PBM" type="material">
