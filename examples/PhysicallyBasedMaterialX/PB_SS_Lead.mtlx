  <!-- Generated shader: Lead_SS_SHD_PBM -->
  <standard_surface name="Lead_SS_SHD_PBM" type="surfaceshader" uiname="Lead" uifolder="Metal" doc="Reference: https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/300/lead.avif">
    <input name="base_color" type="color3" value="0.626, 0.64, 0.693" colorspace="lin_rec709" />
    <input name="metalness" type="float" value="1" />
    <input name="specular_color" type="color3" value="0.717, 0.717, 0.696" colorspace="lin_rec709" doc="Format: Gulbrandsen" />
    <input name="specular_roughness" type="float" value="0" />
  </standard_surface>
  <!-- Generated material: Lead_SS_MAT_PBM -->
  <surfacematerial name="Lead_SS_MAT_PBM" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Lead_SS_SHD_PBM" />
  </surfacematerial>
