  <!--  Content processsed via REST API and mapped to MaterialX V1.39.5 -->
  <!--  Target Shading Model: open_pbr_surface -->
  <!--  Utility Author: Bernard Kwok. kwokcb@gmail.com -->
  <!-- Generated shader: Mercury_OPBR_SHD_PBM -->
  <open_pbr_surface name="Mercury_OPBR_SHD_PBM" type="surfaceshader" uiname="Mercury" uifolder="Metal" doc="Mercury is the only metallic element that is known to be liquid at standard conditions.. Reference: https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/300/mercury.avif">
    <input name="base_color" type="color3" value="0.781, 0.78, 0.778" colorspace="lin_rec709" />
    <input name="base_metalness" type="float" value="1" />
    <input name="specular_color" type="color3" value="0.813, 0.852, 0.902" colorspace="lin_rec709" doc="Format: F82" />
    <input name="specular_roughness" type="float" value="0" />
  </open_pbr_surface>
  <!-- Generated material: Mercury_OPBR_MAT_PBM -->
  <surfacematerial name="Mercury_OPBR_MAT_PBM" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Mercury_OPBR_SHD_PBM" />
  </surfacematerial>
</materialx>
