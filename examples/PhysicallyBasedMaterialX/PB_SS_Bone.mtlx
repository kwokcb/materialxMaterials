  <!--  Target Shading Model: standard_surface -->
  <!--  Utility Author: Bernard Kwok. kwokcb@gmail.com -->
  <!-- Generated shader: Bone_SS_SHD_PBM -->
  <standard_surface name="Bone_SS_SHD_PBM" type="surfaceshader" uiname="Bone" uifolder="Organic" doc="Reference: https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/600/bone.jpeg">
    <input name="base_color" type="color3" value="0.793,0.793,0.664" />
    <input name="metalness" type="float" value="0" />
    <input name="specular_roughness" type="float" value="0.9" />
    <input name="specular_IOR" type="float" value="1.5" />
  </standard_surface>
  <!-- Generated material: Bone_SS_MAT_PBM -->
  <surfacematerial name="Bone_SS_MAT_PBM" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Bone_SS_SHD_PBM" />
  </surfacematerial>
</materialx>
