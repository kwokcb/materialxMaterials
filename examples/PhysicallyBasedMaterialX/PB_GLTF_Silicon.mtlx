  <!-- Generated shader: Silicon_GLTF_SHD_PBM -->
  <gltf_pbr name="Silicon_GLTF_SHD_PBM" type="surfaceshader" uiname="Silicon" uifolder="Metal" doc="Reference: https://raw.githubusercontent.com/AntonPalmqvist/physically-based-api/main/images/renders/cycles/600/silicon.jpeg">
    <input name="base_color" type="color3" value="0.345,0.369,0.426" />
