    <input name="specular_color" type="color3" value="0.081,0,0.004" />
    <input name="roughness" type="float" value="0" />
    <input name="ior" type="float" value="1.5" />
  </gltf_pbr>
  <!-- Generated material: Silicon_GLTF_MAT_PBM -->
  <surfacematerial name="Silicon_GLTF_MAT_PBM" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="Silicon_GLTF_SHD_PBM" />
