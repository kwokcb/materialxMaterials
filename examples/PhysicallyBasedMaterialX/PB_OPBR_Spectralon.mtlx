    <input name="base_color" type="color3" value="0.99, 0.99, 0.99" colorspace="lin_rec709" />
    <input name="base_metalness" type="float" value="0" />
    <input name="specular_roughness" type="float" value="0.99" />
    <input name="specular_ior" type="float" value="1.35" />
  </open_pbr_surface>
  <!-- Generated material: Spectralon_OPBR_MAT_PBM -->
  <surfacematerial name="Spectralon_OPBR_MAT_PBM" type="material">
